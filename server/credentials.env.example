# Copy to a root-readable environment file outside the repository.
# Never commit real values.
LC_INGRESS_TOKEN=replace-with-a-long-random-token
LC_BIND_HOST=0.0.0.0
LC_BIND_PORT=8790
LC_BASE_DIR=/var/lib/loverconnect-ingress
LC_LOCATION_DB=/var/lib/loverconnect-ingress/loverconnect_location.db
LC_LEGACY_STATE=/var/lib/loverconnect-ingress/loverconnect_state.json
LC_LOG_LEVEL=INFO

RIKKA_API=http://127.0.0.1:8080
RIKKA_CONV_ID=replace-with-conversation-id
RIKKA_API_TOKEN=replace-with-rikkahub-web-token
# Keep false when the installed RikkaHub POST endpoint is intentionally unauthenticated.
RIKKA_SEND_WITH_AUTH=false

# Optional OpenAI-compatible fallback. Rules remain the first decision layer.
# LC_REPORT_LLM_URL=https://provider.example/v1
# LC_REPORT_LLM_KEY=replace-with-provider-key
# LC_REPORT_LLM_MODEL=replace-with-model

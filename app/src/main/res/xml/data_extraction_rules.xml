<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lc_config.xml" />
        <exclude domain="sharedpref" path="lc_diagnostics.xml" />
        <exclude domain="sharedpref" path="lc_service_control.xml" />
        <exclude domain="file" path="lc_memory.json" />
        <exclude domain="file" path="lc_eyes_log.txt" />
        <exclude domain="sharedpref" path="lc_location_secure.xml" />
        <exclude domain="sharedpref" path="lc_location_runtime.xml" />
        <exclude domain="sharedpref" path="lc_device_context_config.xml" />
        <exclude domain="sharedpref" path="lc_device_context_runtime.xml" />
        <exclude domain="sharedpref" path="lc_mcp_security.xml" />
        <exclude domain="database" path="lc_location_events.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lc_config.xml" />
        <exclude domain="sharedpref" path="lc_diagnostics.xml" />
        <exclude domain="sharedpref" path="lc_service_control.xml" />
        <exclude domain="file" path="lc_memory.json" />
        <exclude domain="file" path="lc_eyes_log.txt" />
        <exclude domain="sharedpref" path="lc_location_secure.xml" />
        <exclude domain="sharedpref" path="lc_location_runtime.xml" />
        <exclude domain="sharedpref" path="lc_device_context_config.xml" />
        <exclude domain="sharedpref" path="lc_device_context_runtime.xml" />
        <exclude domain="sharedpref" path="lc_mcp_security.xml" />
        <exclude domain="database" path="lc_location_events.db" />
    </device-transfer>
</data-extraction-rules>
